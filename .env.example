# ── Domain
    DOMAIN=your-domain.com

    # ── Database
    DB_PASSWORD=strong-random-password-here

    # ── JWT
    JWT_SECRET=very-long-random-string-at-least-32-characters

    # ── Traccar admin account
    TRACCAR_ADMIN_EMAIL=admin@your-domain.com
    TRACCAR_ADMIN_PASSWORD=traccar-admin-password

    # ── Geoapify map tiles (keep this value only in the server .env)
    GEOAPIFY_API_KEY=
    GEOAPIFY_MAP_STYLE=osm-bright
    